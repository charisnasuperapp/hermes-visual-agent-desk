{
  "name": "hermes-visual-agent-desk",
  "displayName": "Hermes Pixel Office",
  "description": "Retro 2D Pixel-Art Virtual Agent Floor for Hermes Intelligence Systems",
  "version": "6.0.0",
  "publisher": "charisna",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hermesDesk.open",
        "title": "Hermes: Open Visual Agent Desk",
        "category": "Hermes Desk"
      },
      {
        "command": "hermesDesk.open2D",
        "title": "Hermes: Open 2D Pixel Office",
        "category": "Hermes Desk"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "hermes-desk-panel",
          "title": "Hermes Desk",
          "icon": "$(layout-panel)"
        }
      ]
    },
    "views": {
      "hermes-desk-panel": [
        {
          "type": "webview",
          "id": "hermesDesk.sidebarView",
          "name": "Hermes Office"
        }
      ]
    }
  }
}
